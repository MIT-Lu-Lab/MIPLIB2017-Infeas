# Editors read this without being configured, so the repository states its own
# layout rather than depending on what each person happens to have set. The
# same ground the .gitattributes rule covers for git.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,css,js,toml}]
indent_size = 2

# Copied from upstream and shipped as received.
[fonts/LICENSE.txt]
trim_trailing_whitespace = false
