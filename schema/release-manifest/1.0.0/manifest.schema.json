{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mit-lu-lab.github.io/MIPLIB2017-Infeas/schema/release-manifest/1.0.0/manifest.schema.json",
  "title": "MIPLIB2017-Infeas release manifest 1.0.0",
  "description": "An immutable inventory of the payload assets in one GitHub Release. The manifest itself is deliberately outside artifacts so it never hashes itself. Licence conclusions do not belong here: notice assets are named and hashed, while LICENSE remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset",
    "release",
    "sidecar_schema",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "dataset": {
      "const": "MIPLIB2017-Infeas"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "source_commit"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}$",
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          }
        },
        "source_commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "sidecar_schema": {
      "$ref": "#/$defs/assetName",
      "description": "The artifact containing the sidecar JSON Schema. Its artifact entry is the authority for role, size and digest; the schema's $id is the authority for its canonical URL."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "$comment": "scripts/release_contract.py additionally enforces unique artifact names and binds sidecar_schema to an artifact with the schema role; draft 2020-12 cannot express those value joins.",
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {"role": {"const": "notice"}}
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {"const": "verify-published.csv"},
              "role": {"const": "verification"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["role"],
              "properties": {"role": {"const": "verification"}}
            },
            "then": {
              "properties": {"name": {"const": "verify-published.csv"}}
            }
          }
        ],
        "required": [
          "name",
          "role",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/assetName"
          },
          "role": {
            "enum": [
              "instance",
              "sidecar",
              "archive",
              "index",
              "notice",
              "schema",
              "verification"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "assetName": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "not": {
        "pattern": "[\\r\\n\\u2028\\u2029]"
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
